# =====================================================================
# Task Capture - Root environment variables (copy to .env for local dev)
# =====================================================================
# Each app has its own .env.example as well; root values can be sourced
# by individual apps or used by tooling (e.g. the Supabase CLI).

# ---- Supabase (local dev defaults) ---------------------------------------
# Run `pnpm --filter @task-capture/db run db:start` to launch a local stack
# matching the ports configured in packages/db/supabase/config.toml.
#
# These defaults match what `supabase start` prints. Replace with your
# project values when pointing at a hosted Supabase project.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- API ----
API_HOST=0.0.0.0
API_PORT=4000
API_LOG_LEVEL=info
API_CORS_ORIGIN=http://localhost:3000

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# ---- AI ----
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---- Google / Gmail OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
