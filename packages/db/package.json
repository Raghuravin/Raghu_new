{
  "name": "@task-capture/db",
  "version": "0.1.0",
  "private": true,
  "description": "Database schema, migrations, and typed queries for Task Capture (Supabase / Postgres).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "src",
    "supabase"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist *.tsbuildinfo",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types typescript --local > src/generated.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@task-capture/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "rimraf": "^6.0.1"
  }
}
