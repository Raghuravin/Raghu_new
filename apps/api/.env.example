# --- Runtime ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_LOG_LEVEL=info
API_CORS_ORIGIN=http://localhost:3000

# --- Supabase ---
# Defaults match `supabase start` (see packages/db/supabase/config.toml).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
SUPABASE_ANON_KEY=your-local-anon-key
# HS256 secret Supabase signs JWTs with. Find via `supabase status` or in
# the project dashboard. Required for Bearer-token authenticated requests.
SUPABASE_JWT_SECRET=

# --- Auth ---
# When 'true', requireAuth allows unauthenticated requests and substitutes
# a deterministic dev user. Defaults to 'true' in development.
AUTH_DEV_MODE=true

# --- AI (used by @task-capture/ai) ---
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Google / Gmail OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
